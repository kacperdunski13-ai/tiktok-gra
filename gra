<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TikTok Live 3D - Bitwa o Arenę</title>
    <style>
        body { margin: 0; overflow: hidden; background-color: #0f0f1a; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: white; user-select: none; }
        #ui { position: absolute; top: 20px; width: 100%; text-align: center; pointer-events: none; z-index: 10; }
        h1 { margin: 0; font-size: 28px; text-transform: uppercase; letter-spacing: 2px; text-shadow: 0 0 15px rgba(255,0,80,0.8); }
        .scores { display: flex; justify-content: center; gap: 40px; margin-top: 15px; font-size: 24px; font-weight: bold; }
        .team-red { color: #ff2a55; text-shadow: 0 0 10px rgba(255,42,85,0.6); }
        .team-blue { color: #00f2fe; text-shadow: 0 0 10px rgba(0,242,254,0.6); }
        #legend { position: absolute; bottom: 20px; width: 100%; text-align: center; font-size: 15px; background: rgba(0,0,0,0.7); padding: 12px 0; z-index: 10; }
        #feed { position: absolute; top: 120px; width: 100%; text-align: center; font-size: 16px; color: #ffd700; text-shadow: 1px 1px 3px black; z-index: 10; }
        
        /* Panel testowy widoczny na dole dla Ciebie */
        #test-panel { position: absolute; bottom: 70px; width: 100%; text-align: center; z-index: 20; }
        button { background: #222; color: white; border: 1px solid #555; padding: 8px 15px; margin: 0 5px; cursor: pointer; border-radius: 5px; font-weight: bold; transition: 0.2s; }
        button:hover { background: #444; transform: scale(1.05); }
        .btn-red { border-color: #ff2a55; color: #ff2a55; }
        .btn-blue { border-color: #00f2fe; color: #00f2fe; }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>
    <div id="ui">
        <h1>Bitwa na Arenie 3D</h1>
        <div class="scores">
            <div class="team-red">CZERWONI: <span id="scoreRed">0</span></div>
            <div class="team-blue">NIEBIESCY: <span id="scoreBlue">0</span></div>
        </div>
    </div>
    <div id="feed">Wyślij prezent na TikToku lub przetestuj przyciskami poniżej!</div>
    
    <!-- Panel testowy, żebyś mógł kliknąć i sprawdzić jak gra działa -->
    <div id="test-panel">
        <button class="btn-red" onclick="simulateGift('red', 'Róża', 1)">🌹 Test: Róża (+1 Czerwoni)</button>
        <button class="btn-blue" onclick="simulateGift('blue', 'Serce', 1)">❤️ Test: Serce (+1 Niebiescy)</button>
    </div>

    <div id="legend">
        🌹 <b>Róża</b> = +1 Czerwoni &nbsp;|&nbsp; ❤️ <b>Serce / Inne</b> = +1 Niebiescy
    </div>

    <script>
        // --- SCENA 3D (THREE.JS) ---
        const scene = new THREE.Scene();
        scene.fog = new THREE.FogExp2(0x0f0f1a, 0.035);

        const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.set(0, 8, 14);
        camera.lookAt(0, 0, 0);

        const renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        document.body.appendChild(renderer.domElement);

        // Oświetlenie
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
        scene.add(ambientLight);
        const dirLight = new THREE.DirectionalLight(0xffffff, 1);
        dirLight.position.set(5, 15, 10);
        scene.add(dirLight);

        // Podłoga / siatka areny
        const gridHelper = new THREE.GridHelper(20, 20, 0x444466, 0x222233);
        scene.add(gridHelper);

        // Kostka na środku walcząca o pozycję
        const coreGeo = new THREE.BoxGeometry(2.5, 2.5, 2.5);
        const coreMat = new THREE.MeshStandardMaterial({ color: 0xffd700, metalness: 0.7, roughness: 0.2 });
        const core = new THREE.Mesh(coreGeo, coreMat);
        core.position.y = 1.25;
        scene.add(core);

        // Boczne bazy drużyn
        const redBase = new THREE.Mesh(new THREE.BoxGeometry(1, 3, 6), new THREE.MeshStandardMaterial({ color: 0xff2a55 }));
        redBase.position.set(-9, 1.5, 0);
        scene.add(redBase);

        const blueBase = new THREE.Mesh(new THREE.BoxGeometry(1, 3, 6), new THREE.MeshStandardMaterial({ color: 0x00f2fe }));
        blueBase.position.set(9, 1.5, 0);
        scene.add(blueBase);

        // Stan gry
        let scoreRed = 0;
        let scoreBlue = 0;
        let targetX = 0;

        function triggerAction(team, user, giftName, points) {
            if (team === 'red') {
                scoreRed += points;
            } else {
                scoreBlue += points;
            }

            document.getElementById('scoreRed').innerText = scoreRed;
            document.getElementById('scoreBlue').innerText = scoreBlue;

            // Przesuwanie środkowej kostki w stronę przegrywającego / popychana przez wygrywającego
            const diff = scoreBlue - scoreRed;
            targetX = Math.max(-7, Math.min(7, diff * 0.4));

            // Komunikat na ekranie
            const feed = document.getElementById('feed');
            feed.innerHTML = `🎁 <b>${user}</b> wysłał <b>${giftName}</b>!`;

            // Efekt uderzenia/skoku kostki
            core.scale.set(1.4, 1.4, 1.4);

            // Warunek wygranej rundy
            if (targetX <= -7) {
                endRound("CZERWONI WYGRYWAJĄ RUNDĘ!");
            } else if (targetX >= 7) {
                endRound("NIEBIESCY WYGRYWAJĄ RUNDĘ!");
            }
        }

        function endRound(text) {
            document.getElementById('feed').innerHTML = `<span style="font-size:22px; color:#00ff88;">🏆 ${text}</span>`;
            scoreRed = 0;
            scoreBlue = 0;
            targetX = 0;
            document.getElementById('scoreRed').innerText = 0;
            document.getElementById('scoreBlue').innerText = 0;
        }

        // Pętla animacji 3D
        function animate() {
            requestAnimationFrame(animate);
            core.rotation.x += 0.015;
            core.rotation.y += 0.02;
            core.position.x += (targetX - core.position.x) * 0.1;
            core.scale.lerp(new THREE.Vector3(1, 1, 1), 0.1);
            renderer.render(scene, camera);
        }
        animate();

        // Dopasowanie do ekranu
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        // Funkcja testowa do przycisków
        function simulateGift(team, giftName, pts) {
            triggerAction(team, "WidzTestowy", giftName, pts);
        }
    </script>
</body>
</html>
